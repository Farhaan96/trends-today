{
  "version": 5,
  "timezone": "America/Vancouver",
  "daily": {
    "maximumPublications": 6,
    "minimumPublications": 0,
    "sweeps": [
      {
        "name": "06:30 sweep",
        "preferredStartTime": "06:30",
        "maximumPublications": 2
      },
      {
        "name": "08:30 sweep",
        "preferredStartTime": "08:30",
        "maximumPublications": 2
      },
      {
        "name": "10:30 sweep",
        "preferredStartTime": "10:30",
        "maximumPublications": 2
      },
      {
        "name": "12:30 sweep",
        "preferredStartTime": "12:30",
        "maximumPublications": 2
      },
      {
        "name": "14:30 sweep",
        "preferredStartTime": "14:30",
        "maximumPublications": 2
      },
      {
        "name": "16:30 sweep",
        "preferredStartTime": "16:30",
        "maximumPublications": 2
      },
      {
        "name": "18:30 sweep",
        "preferredStartTime": "18:30",
        "maximumPublications": 2
      }
    ],
    "skipWhenNoCandidateQualifies": true
  },
  "weeklyReview": {
    "preferredDay": "monday",
    "preferredStartTime": "08:30",
    "minimumComparableArticlesPerBeat": 8,
    "windowsDays": [7, 28],
    "changeOneMaterialVariable": true
  },
  "gates": [
    "lower-mainland-relevance",
    "freshness-and-reader-utility",
    "opportunity-score-and-evidence",
    "duplicate-check",
    "source-and-claim-validation",
    "original-image-validation",
    "exact-candidate-gpt-editorial-review",
    "exact-candidate-claude-release-review",
    "deterministic-tests-and-build",
    "clean-pull-request-checks",
    "explicit-owner-publication-approval",
    "explicit-owner-merge-approval",
    "explicit-owner-deployment-approval",
    "production-deployment",
    "live-browser-verification"
  ],
  "storyTypes": {
    "bulletin": {
      "wordRange": [300, 600],
      "minimumSources": 1,
      "requiresPrimarySource": true
    },
    "reported-update": {
      "wordRange": [550, 950],
      "minimumSources": 2,
      "requiresPrimarySource": true
    },
    "guide-or-explainer": {
      "wordRange": [800, 1400],
      "minimumSources": 3,
      "requiresPrimarySource": true
    }
  },
  "measurement": {
    "primaryMetric": "organic engaged sessions per article after 28 days",
    "leadingMetrics": [
      "search impressions",
      "search clicks",
      "organic click-through rate",
      "engaged sessions",
      "returning sessions",
      "app CTA clicks"
    ],
    "missingValues": "unavailable",
    "neverCoerceMissingToZero": true,
    "availabilityStates": ["available", "pending", "unavailable", "error"],
    "zeroRequiresVerifiedProviderResponse": true
  }
}
